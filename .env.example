# Copiá este archivo como .env.local y completá los valores. Nunca subas claves reales al repositorio.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor: permite crear pedidos, confirmar pagos y registrar eventos. No la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (asistentes de IA) ---
ANTHROPIC_API_KEY=
# Opcional: modelo y nivel de esfuerzo de cada asistente.
ANTHROPIC_MODEL=claude-opus-5-5
SHOPPER_AI_EFFORT=low
ADMIN_AI_EFFORT=medium

# --- Pagos con tarjeta ---
# mock = simulador para desarrollo · bancard = Bancard vPOS (Paraguay)
PAYMENT_PROVIDER=mock
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
# Staging: https://vpos.infonet.com.py:8888 · Producción: https://vpos.infonet.com.py
BANCARD_BASE_URL=https://vpos.infonet.com.py:8888

# --- Tareas programadas (Vercel Cron) ---
CRON_SECRET=
