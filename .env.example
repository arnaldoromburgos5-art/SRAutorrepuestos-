# Copiá este archivo como .env.local y completá los valores. Nunca subas claves reales al repositorio.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Publishable key (sb_publishable_...). También se acepta NEXT_PUBLIC_SUPABASE_ANON_KEY (clave legacy "anon").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sólo servidor: Secret key (sb_secret_...). También se acepta SUPABASE_SERVICE_ROLE_KEY (legacy).
# Permite crear pedidos, confirmar pagos y registrar eventos. Nunca la expongas ni la subas al repositorio.
SUPABASE_SECRET_KEY=

# --- Asistentes de IA ---
# gemini (Google, tiene capa gratuita) o anthropic (Claude). Si se omite, se usa el que tenga clave.
# Clave gratis de Gemini: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Opcional, sólo si usás Claude:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
SHOPPER_AI_EFFORT=low
ADMIN_AI_EFFORT=medium

# --- Pagos con tarjeta ---
# mock = simulador para desarrollo · bancard = Bancard vPOS (Paraguay)
PAYMENT_PROVIDER=mock
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
# Staging: https://vpos.infonet.com.py:8888 · Producción: https://vpos.infonet.com.py
BANCARD_BASE_URL=https://vpos.infonet.com.py:8888

# --- Tareas programadas (Vercel Cron) ---
CRON_SECRET=
